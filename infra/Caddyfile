# CryptoShop — Caddy Reverse Proxy
# Automatisches TLS (Let's Encrypt) via ACME, TLS 1.3, HSTS, strikte
# Security-Header zusätzlich zu den anwendungsseitig gesetzten (helmet im
# Backend, SvelteKit-CSP in frontend/admin). Kein Fremd-CDN.
#
# Wichtig für die Cookie-Sicherheit: Shop und Admin-Panel sprechen jeweils
# die API auf IHRER EIGENEN Domain an (same-origin). Dadurch funktionieren
# SameSite=Strict-Cookies, es wird kein CORS benötigt und ein XSS im
# öffentlichen Shop kann die Admin-API nicht mit Anmeldedaten aufrufen.

{
	# admin@example.invalid für ACME-Benachrichtigungen anpassen.
	email admin@example.invalid
}

# Wiederverwendbare Bausteine
(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}
}

(privacy_log) {
	log {
		# Datensparsamkeit (Konzept Abschnitt 9): keine IP-Adressen, keine
		# Cookies in Access-Logs. Bestell-Tokens (UUIDs) im Pfad werden
		# maskiert, da sie als Capability-Token den Bestellstatus freigeben.
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers>Cookie delete
				request>headers>Set-Cookie delete
				request>uri regexp "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" ":id"
			}
		}
	}
}

# --- Kunden-Shop + öffentliche API ---------------------------------------
{$SHOP_DOMAIN} {
	encode gzip zstd
	import security_headers
	import privacy_log

	# Öffentliche API und Artikelbilder
	handle /api/* {
		reverse_proxy backend:3000
	}
	handle /uploads/* {
		reverse_proxy backend:3000
	}

	# Das Admin-Backend ist auf der Shop-Domain bewusst NICHT erreichbar –
	# es wird ausschließlich unter der Admin-Domain gemountet (s.u.).
	handle /admin/* {
		respond "Not Found" 404
	}

	# Kunden-Shop (SvelteKit/adapter-node)
	handle {
		reverse_proxy frontend:3000
	}
}

# --- Admin-Panel (statische SPA + Admin-API, same-origin) ----------------
{$ADMIN_DOMAIN} {
	encode gzip zstd
	import security_headers
	import privacy_log

	header {
		X-Robots-Tag "noindex, nofollow"
	}

	# Admin-API und CSRF-Endpoint auf derselben Domain wie die SPA,
	# damit SameSite=Strict-Cookies greifen und kein CORS nötig ist.
	handle /admin/* {
		reverse_proxy backend:3000
	}
	handle /api/* {
		reverse_proxy backend:3000
	}
	handle /uploads/* {
		reverse_proxy backend:3000
	}

	# Statisches SPA-Bundle mit Fallback auf index.html (Client-Routing)
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

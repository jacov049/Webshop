# Basis-URL des Backend-APIs. In Produktion i.d.R. über den Reverse Proxy
# (Caddy) unter demselben Origin gemountet, z.B. "/api" (leer lassen und
# via Caddy-Pfad "/api/*" -> Backend routen). Für lokale Entwicklung zeigt
# dies auf den separat laufenden Backend-Dev-Server.
PUBLIC_API_BASE_URL=http://localhost:3000

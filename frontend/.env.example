# Basis-URL des Backend-APIs. In Produktion i.d.R. leer lassen, damit
# Requests same-origin über Caddy laufen.
PUBLIC_API_BASE_URL=http://localhost:3000

# Erwarteter Fingerprint des unter /pgp-public-key.asc ausgelieferten
# Betreiber-Public-Keys. Ohne passenden Fingerprint verweigert der Checkout
# die Verschlüsselung, um Fehl-Deployments mit einem falschen Key zu erkennen.
PUBLIC_PGP_PUBLIC_KEY_FINGERPRINT=
